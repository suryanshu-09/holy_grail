# Backend API image (PLAN4 Phase 25 §30.1).
# Multi-stage: Go builder -> minimal Alpine runtime, non-root, static binary.
# Build:   docker build -f Dockerfile.api -t holy-grail-api .
# Run env: HOST=0.0.0.0 PORT=8080 DATABASE_URL=... REDIS_ADDR=... APP_ENV=production

# ---- builder ----
FROM golang:1.26-alpine AS builder
WORKDIR /src
# Cache module downloads separately from source changes.
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY migrations/ ./migrations/
# Static binary for a libc-free runtime; trimpath strips host paths.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

# ---- runtime ----
FROM alpine:3.20 AS runtime
# ca-certificates: outbound TLS (OpenAI, Postgres). wget: HEALTHCHECK probe.
# tesseract/poppler intentionally omitted: OCR degrades gracefully to a
# logged warning (see NewTesseractOCR callers) to keep the image minimal.
RUN apk add --no-cache ca-certificates wget \
    && addgroup -S appgroup && adduser -S appuser -G appgroup
WORKDIR /app
COPY --from=builder /out/api /app/api
# Writable file-storage root for the non-root user (STORAGE_PATH).
RUN mkdir -p /app/data && chown -R appuser:appgroup /app
USER appuser
EXPOSE 8080
ENV HOST=0.0.0.0 \
    PORT=8080 \
    APP_ENV=production \
    STORAGE_PATH=/app/data \
    STORAGE_BACKEND=local \
    SENTRY_DSN= \
    RATE_LIMIT_RPS=100
# Exec form preserves SIGTERM so cmd/api's graceful shutdown runs.
ENTRYPOINT ["/app/api"]
# API health endpoint (plain GET: the handler rejects HEAD with 405, so no
# --spider); start-period covers cold starts + DB reconnect.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:8080/api/v1/health || exit 1
