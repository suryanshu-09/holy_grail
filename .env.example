# Database (for local development)
POSTGRES_USER=pguser
POSTGRES_PASSWORD=pgpass
POSTGRES_DB=holygrail_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Application environment (development | production)
APP_ENV=development

# Redis (for background jobs)
REDIS_ADDR=localhost:6379

# Auth (Phase 20): sessions use HttpOnly SameSite=Lax cookies; the Secure
# flag is set automatically when APP_ENV=production. Login/register are
# rate-limited to 10 attempts per minute per client IP.

# AI (optional; LLM/embeddings/vision stay disabled when empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64

# Observability (Phase 26): JSON logs when APP_ENV=production; error
# reports POST to SENTRY_DSN (empty = disabled, local log only);
# GET /api/v1/metrics exposes uptime/goroutines/db pool stats.
SENTRY_DSN=

# Production stack (Phase 25): secrets are injected via environment, never
# committed. Copy this file to .env and set real values before
# `docker compose up --build -d`.
APP_ENV=development
CORS_ALLOWED_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
API_PORT=8080
WEB_PORT=3000
REDIS_PORT=6379

# Production database URL (Phase 26): required when APP_ENV=production;
# must use TLS (sslmode=require, never disable). Local dev may use POSTGRES_*
# parts above instead.
DATABASE_URL=

# Object storage (Phase 26): local (default, STORAGE_PATH root) or s3
# (S3-compatible: AWS S3, Cloudflare R2, MinIO) via the Storage interface.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Database backups (Phase 26): ./scripts/db-backup.sh / `make db-backup`.
# BACKUP_DIR: dump destination; BACKUP_RETENTION_COUNT: newest N kept (0=all);
# BACKUP_PREFIX: filename prefix. Restore with `make db-restore FILE=...`.
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=7
BACKUP_PREFIX=holygrail
